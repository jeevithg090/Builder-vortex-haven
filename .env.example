# Copy to `.env.local` and fill in as needed. All variables are optional.
# Only variables prefixed with VITE_ are exposed to the browser bundle, so
# never put private keys here.

# HTTPS endpoint that accepts a JSON POST of the contact form
# (e.g. a Formspree form URL or your own serverless function).
# When empty, the form opens the visitor's mail client instead.
VITE_CONTACT_ENDPOINT=

# Address used for the mailto fallback and shown in the contact section.
VITE_CONTACT_EMAIL=hello@theagency.com
